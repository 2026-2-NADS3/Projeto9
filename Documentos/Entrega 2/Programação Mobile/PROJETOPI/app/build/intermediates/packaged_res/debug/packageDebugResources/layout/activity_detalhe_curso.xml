<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DetalheCursoActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_voltar"
        app:title="Detalhes do curso" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/ivDetalheImagem"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:contentDescription="Imagem do curso"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvDetalheTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivDetalheImagem" />

            <TextView
                android:id="@+id/tvDetalheInstituicao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary"
                app:layout_constraintEnd_toEndOf="@id/tvDetalheTitulo"
                app:layout_constraintStart_toStartOf="@id/tvDetalheTitulo"
                app:layout_constraintTop_toBottomOf="@id/tvDetalheTitulo" />

            <LinearLayout
                android:id="@+id/layoutTagsDetalhe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="@id/tvDetalheTitulo"
                app:layout_constraintStart_toStartOf="@id/tvDetalheTitulo"
                app:layout_constraintTop_toBottomOf="@id/tvDetalheInstituicao">

                <TextView
                    android:id="@+id/tvTagDiaUnico"
                    style="@style/TextoTag"
                    android:layout_marginEnd="6dp"
                    android:text="DIA ÚNICO" />

                <TextView
                    android:id="@+id/tvTagArea"
                    style="@style/TextoTag" />
            </LinearLayout>

            <!-- Informações do curso -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInfo"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="@id/tvDetalheTitulo"
                app:layout_constraintStart_toStartOf="@id/tvDetalheTitulo"
                app:layout_constraintTop_toBottomOf="@id/layoutTagsDetalhe">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvDetalhePeriodo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        app:drawableStartCompat="@drawable/ic_agenda" />

                    <TextView
                        android:id="@+id/tvDetalheHorario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        app:drawableStartCompat="@drawable/ic_relogio" />

                    <TextView
                        android:id="@+id/tvDetalheLocal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        app:drawableStartCompat="@drawable/ic_local" />

                    <TextView
                        android:id="@+id/tvDetalheCarga"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_cursos" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvSobre"
                style="@style/TituloSecao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Sobre o curso"
                app:layout_constraintStart_toStartOf="@id/tvDetalheTitulo"
                app:layout_constraintTop_toBottomOf="@id/cardInfo" />

            <TextView
                android:id="@+id/tvDetalheDescricao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                app:layout_constraintEnd_toEndOf="@id/tvDetalheTitulo"
                app:layout_constraintStart_toStartOf="@id/tvDetalheTitulo"
                app:layout_constraintTop_toBottomOf="@id/tvSobre" />

            <!-- Progresso (só aparece se o aluno estiver inscrito) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProgresso"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/tvDetalheTitulo"
                app:layout_constraintStart_toStartOf="@id/tvDetalheTitulo"
                app:layout_constraintTop_toBottomOf="@id/tvDetalheDescricao">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvProgressoTitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Minha participação"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProgressoTexto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/pbProgresso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btnInscrever"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Quero me inscrever"
                app:layout_constraintEnd_toEndOf="@id/tvDetalheTitulo"
                app:layout_constraintStart_toStartOf="@id/tvDetalheTitulo"
                app:layout_constraintTop_toBottomOf="@id/cardProgresso" />

            <Button
                android:id="@+id/btnVerCertificado"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ver certificado"
                android:visibility="gone"
                app:icon="@drawable/ic_certificado"
                app:layout_constraintEnd_toEndOf="@id/tvDetalheTitulo"
                app:layout_constraintStart_toStartOf="@id/tvDetalheTitulo"
                app:layout_constraintTop_toBottomOf="@id/btnInscrever" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
