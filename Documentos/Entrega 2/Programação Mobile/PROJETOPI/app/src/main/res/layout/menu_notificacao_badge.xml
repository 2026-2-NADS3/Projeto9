<?xml version="1.0" encoding="utf-8"?>
<!-- Ícone de sino com contador de notificações não lidas (usado na Toolbar) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/ivSino"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:contentDescription="Notificações"
        android:src="@drawable/ic_notificacao"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/tvBadgeNotificacoes"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_badge_contador"
        android:gravity="center"
        android:minWidth="18dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/white"
        android:textSize="10dp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
