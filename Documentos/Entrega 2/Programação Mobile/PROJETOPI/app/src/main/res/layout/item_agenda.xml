<?xml version="1.0" encoding="utf-8"?>
<!-- Encontro da agenda: bloco com dia/mês (amarelo = dia único) e informações ao lado -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    app:cardCornerRadius="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/blocoData"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bloco_data"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvAgendaDia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAgendaMes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12dp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAgendaDisciplina"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/ivPresenca"
            app:layout_constraintStart_toEndOf="@id/blocoData"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivPresenca"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Presença confirmada"
            android:src="@drawable/ic_check"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/verde_concluido" />

        <TextView
            android:id="@+id/tvAgendaData"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvAgendaDisciplina"
            app:layout_constraintTop_toBottomOf="@id/tvAgendaDisciplina" />

        <TextView
            android:id="@+id/tvAgendaHorario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_relogio"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvAgendaDisciplina"
            app:layout_constraintTop_toBottomOf="@id/tvAgendaData" />

        <TextView
            android:id="@+id/tvAgendaLocal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:drawableStartCompat="@drawable/ic_local"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvAgendaDisciplina"
            app:layout_constraintTop_toBottomOf="@id/tvAgendaHorario" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvAgendaDisciplina"
            app:layout_constraintTop_toBottomOf="@id/tvAgendaLocal">

            <TextView
                android:id="@+id/tvTagDiaUnico"
                style="@style/TextoTag"
                android:layout_marginEnd="6dp"
                android:text="DIA ÚNICO" />

            <TextView
                android:id="@+id/tvAgendaSituacao"
                style="@style/TextoTag" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
