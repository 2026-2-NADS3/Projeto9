<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Acesso à API REST e verificação de conexão -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Notificações (Android 13+ pede permissão ao usuário) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Câmera para ler o QR Code do check-in -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".ProximaEtapaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PROJETOPI"
        tools:targetApi="31">

        <!-- Tela inicial (abre ao tocar no ícone do app) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".LoginActivity" android:exported="false" />
        <activity android:name=".FormActivity" android:exported="false" android:launchMode="singleTop" />
        <activity android:name=".ResultadoActivity" android:exported="false" />
        <activity android:name=".DetalheCursoActivity" android:exported="false" />
        <activity android:name=".NotificacoesActivity" android:exported="false" />
        <activity android:name=".HistoricoActivity" android:exported="false" />
        <activity android:name=".CertificadosActivity" android:exported="false" />
        <activity android:name=".CertificadoActivity" android:exported="false" />
        <activity android:name=".TestePerfilActivity" android:exported="false" />
        <activity android:name=".ResultadoTesteActivity" android:exported="false" />
        <activity android:name=".MensagensActivity" android:exported="false" />
        <activity android:name=".EditarPerfilActivity" android:exported="false" />

        <!-- Leitor de QR Code (biblioteca ZXing): libera a rotação da tela -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />

        <!-- Compartilhamento da imagem do certificado -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
